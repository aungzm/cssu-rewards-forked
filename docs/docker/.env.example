# Workflow image name. Available after the first successful GHCR publication.
APP_IMAGE=ghcr.io/aungzm/cssu-rewards-forked:demo

# The URL selects SQLite or PostgreSQL automatically. No database type flag needed.
# SQLite: jdbc:sqlite:/data/rewards.db
# PostgreSQL: jdbc:postgresql://your-db-host:5432/cssu_rewards
DATABASE_URL=jdbc:sqlite:/data/rewards.db
# Only used for PostgreSQL. Ignored for SQLite.
DATABASE_USER=postgres
DATABASE_PASSWORD=

# The existing backend reads DEMO_MODE, not DEMO or demo.
DEMO_MODE=true

# Browser origin allowed by the API, especially behind a reverse proxy.
# Use your public site URL with https:// and NO trailing slash.
# Multiple origins can be comma-separated. Not a Vite/build-time setting.
CORS_ORIGINS=https://cssu-rewards.aungzm.com

PORT=8080
# Use 0.0.0.0 only if other machines should reach the published port directly.
BIND_ADDRESS=127.0.0.1

# Generate a random secret before deployment. SQLite needs no DB credentials.
# At least 32 UTF-8 bytes. Never expose this through frontend configuration.
JWT_SECRET=

# Optional first account, created only when the users table is empty.
# UTORid must be exactly 8 alphanumeric characters; email must match this domain.
# Blank all three after the first successful startup.
BOOTSTRAP_SUPERUSER_UTORID=Demo0001
BOOTSTRAP_SUPERUSER_EMAIL=demo@mail.utoronto.ca
# At least 8 characters. This grants full administrative access, not a guest role.
BOOTSTRAP_SUPERUSER_PASSWORD=
