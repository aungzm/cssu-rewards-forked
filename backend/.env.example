# Environment mode: development, production, or test
NODE_ENV=development

# Server port (used in production mode)
PORT=3000

# JWT secret for authentication tokens
# Generate a secure secret for production: openssl rand -hex 32
JWT_SECRET=your-secure-jwt-secret-here

# PostgreSQL database connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/cssu_rewards

# Allowed CORS origins (comma-separated)
# Add your frontend URL(s) here
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
